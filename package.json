{
  "name": "adonis-kit",
  "version": "0.9.0",
  "description": "API-only AdonisJS starter with multi-tenancy, JWT authentication, RBAC, and private storage.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Gabriel Maia <gabrielmaialva33@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielmaialva33/adonis-kit.git"
  },
  "homepage": "https://github.com/gabrielmaialva33/adonis-kit#readme",
  "bugs": {
    "url": "https://github.com/gabrielmaialva33/adonis-kit/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node --import=@poppinss/ts-exec ace.js build",
    "dev": "node --import=@poppinss/ts-exec ace.js serve --hmr",
    "test": "node --import=@poppinss/ts-exec ace.js test unit",
    "test:e2e": "node --import=@poppinss/ts-exec ace.js test",
    "lint": "eslint .",
    "lint:fix": "eslint \"{app,providers,config,tests,start}/**/*.ts\" --fix --ignore-pattern pnpm-lock.yaml",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "ace": "node --import=@poppinss/ts-exec ace.js",
    "docker": "node ace.js migration:run --force && node bin/server.js"
  },
  "imports": {
    "#modules/*": "./app/modules/*.js",
    "#shared/*": "./app/shared/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@balena/dockerignore": "^1.0.2",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/openapi-assertions": "^0.1.2",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "1.5.2",
    "@swc/core": "^1.16.22",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.7",
    "@types/semver": "^7.8.0",
    "eslint": "^10.15.0",
    "hot-hook": "^1.1.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "semver": "^7.8.6",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-native": "npm:typescript@~7.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.1",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/core": "^7.7.0",
    "@adonisjs/cors": "^3.0.1",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/limiter": "^3.1.0",
    "@adonisjs/lucid": "^22.5.0",
    "@adonisjs/mail": "^10.4.1",
    "@adonisjs/redis": "^10.0.2",
    "@adonisjs/session": "^8.4.0",
    "@adonisjs/shield": "^9.0.1",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@google-cloud/storage": "^8.4.0",
    "@vinejs/vine": "^4.4.0",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "edge.js": "^6.5.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/modules/**/controllers/**/*.ts",
      "./app/shared/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
