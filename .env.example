TZ=UTC
HOST=localhost
PORT=3333
NODE_ENV=development
LOG_LEVEL=info

APP_NAME="Adonis Kit"
APP_URL=http://localhost:3333
APP_SOURCE_URL=https://github.com/gabrielmaialva33/adonis-kit
APP_KEY=
# Use independent high-entropy secrets in production. During local development,
# these secrets fall back to APP_KEY when omitted.
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
# EMAIL_VERIFICATION_SECRET=
# PASSWORD_RESET_SECRET=
PASSWORD_RESET_TTL_MINUTES=60
# Optional external frontend reset page. When unset, email contains API reset instructions.
# PASSWORD_RESET_URL=https://app.example.com/reset-password
JWT_ISSUER=adonis-kit
JWT_AUDIENCE=adonis-kit
JWT_COOKIE_NAME=token
SESSION_COOKIE_NAME=adonis-kit-session

# none | personal. "personal" creates a first workspace for public sign-ups.
REGISTRATION_WORKSPACE_MODE=personal

SESSION_DRIVER=cookie
LIMITER_STORE=database

# Drive (file storage): fs | s3 | spaces | r2 | gcs
DRIVE_DISK=fs

# Database Configuration (PostgreSQL)
# DB_CONNECTION selects the connection in config/database.ts (postgres | sqlite)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=adonis_kit

# Redis (permission cache and optional rate-limit store)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0

# Mail Configuration
# MAIL_MAILER: smtp | mailgun
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Adonis Kit"

# SMTP Configuration. The bundled Docker environment exposes Mailpit on
# localhost:1025 and its inbox UI on http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Mailgun Configuration (when MAIL_MAILER=mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_BASE_URL=https://api.mailgun.net/v3

# ---------------------------------------------------------------------------
# Optional integrations (uncomment and fill in as needed)
# ---------------------------------------------------------------------------

# S3 (when DRIVE_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# DigitalOcean Spaces (when DRIVE_DISK=spaces)
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=
# SPACES_BUCKET=
# SPACES_ENDPOINT=

# Cloudflare R2 (when DRIVE_DISK=r2)
# R2_KEY=
# R2_SECRET=
# R2_BUCKET=
# R2_ENDPOINT=

# Google Cloud Storage (when DRIVE_DISK=gcs)
# Optional inline service-account JSON (not a path or base64 string).
# Requires type="service_account", project_id, client_email and an RSA private_key.
# Use a single-quoted JSON value and preserve the JSON \n escapes in private_key.
# Invalid supplied credentials fail startup; errors never include credential values.
# Leave GCS_KEY unset to use Application Default Credentials (ADC), e.g. the
# attached service account in Google Cloud or GOOGLE_APPLICATION_CREDENTIALS.
# Only the required fields above are forwarded; custom auth endpoints are ignored.
# GCS_KEY=
# GCS_BUCKET=
