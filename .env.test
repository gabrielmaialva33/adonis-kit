# Versioned synthetic fixture. Never put real credentials here.
TZ=UTC
PORT=3334
HOST=localhost
LOG_LEVEL=error
NODE_ENV=test
APP_URL=http://localhost:3334

ACCESS_TOKEN_SECRET=test_access_token_secret_123456789
REFRESH_TOKEN_SECRET=test_refresh_token_secret_123456789
APP_KEY=test_app_key_32_chars_minimum_12345

DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=db_testing

REDIS_HOST=localhost
REDIS_PORT=6379
# CI Redis has no password; override REDIS_* for dedicated local test containers.
REDIS_PASSWORD=

# Sessions are still required for cookie authentication and CSRF.
SESSION_DRIVER=memory
LIMITER_STORE=memory
DRIVE_DISK=fs

# Tests fake mail delivery. Unfaked delivery must fail locally, never contact SMTP.
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Adonis Kit Tests"
SMTP_HOST=127.0.0.1
SMTP_PORT=9
SMTP_USER=
SMTP_PASS=

# Offline GCS adapter tests use ephemeral credentials generated by bin/test.ts.
GCS_BUCKET=synthetic-test-bucket
